# Supabase / PostgreSQL Configuration
# You can use a full connection string or individual PG* variables.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Alternatively, configure individual connection parameters:
PGHOST=db.your-project-ref.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-supabase-password
PGDATABASE=postgres
PGSSL=true

# Supabase API (Optional for direct REST/Realtime client usage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
