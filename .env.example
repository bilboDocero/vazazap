# Supabase / PostgreSQL Configuration
# You can use a full connection string or individual PG* variables.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Alternatively, configure individual connection parameters:
PGHOST=db.your-project-ref.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-supabase-password
PGDATABASE=postgres
PGSSL=true

# Supabase API (Optional for direct REST/Realtime client usage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Asaas Payment Gateway Configuration (API v3)
# Sandbox: https://api-sandbox.asaas.com/v3
# Production: https://api.asaas.com/v3
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=$aact_YTU5YTE0M2M6N2I4MTY...
ASAAS_WEBHOOK_SECRET=your-webhook-secret-token
